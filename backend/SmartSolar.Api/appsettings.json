{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SmartSolar.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "",
    "UsersCollection": "Users",
    "StationsCollection": "SolarStationInfo",
    "SlotsCollection": "EnergyBookingSlots",
    "ReservationsCollection": "EnergyReservation"
  },
  "JwtSettings": {
    "Secret": "",
