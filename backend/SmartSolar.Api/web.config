<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : web.config
  Project     : Smart Solar Microgrid Trading System - Central Web API
  Module      : IIS deployment
  Description : Tells IIS how to host this ASP.NET Core application. The ASP.NET
                Core Module V2 (AspNetCoreModuleV2) forwards requests from IIS to
                the Kestrel server embedded in the published executable.

                hostingModel="inprocess" runs the app inside the IIS worker
                process, which is the faster of the two options. Switch it to
                "outofprocess" only if a hosting restriction requires it.

                REQUIRED ON THE SERVER: the .NET 8 Hosting Bundle must be
                installed, otherwise IIS returns HTTP 500.19 / 500.31.
                Download: https://dotnet.microsoft.com/download/dotnet/8.0
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Route every request to the ASP.NET Core Module. -->
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\SmartSolar.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Production disables the developer exception page; the middleware
               returns the standard JSON envelope instead. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!-- The Android client and the React client both send an Authorization
           header on every call, so it must survive the IIS request pipeline. -->
      <security>
        <requestFiltering>
          <!-- 10 MB is ample for this API; it accepts JSON only. -->
          <requestLimits maxAllowedContentLength="10485760" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <!-- Remove the header that advertises the server technology. -->
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
