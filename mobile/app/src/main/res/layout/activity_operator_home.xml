<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_operator_home.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : Console of a Grid Operator. It repeats the prosumer header
                pattern but names the operator\'s assigned microgrid node, shows
                the node scoped counters from GET /reservations/dashboard, and
                gives the QR scanner - the operator\'s main job - a full width
                primary card of its own.

                Every counter is a value the Web API calculated; the layout only
                provides the placeholders.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <!-- ============ Gradient header: greeting, operator, assigned node ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_rounded"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="44dp">

                <TextView
                    android:id="@+id/text_avatar_initial"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/bg_circle_solar"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="K" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/solar_100"
                        android:textSize="13sp"
                        tools:text="@string/greeting_morning" />

                    <TextView
                        android:id="@+id/text_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Kasun Silva" />

                    <!-- The node this operator is assigned to, sent by the API on the session user. -->
                    <TextView
                        android:id="@+id/text_station_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/solar_100"
                        android:textSize="12sp"
                        tools:text="MG-COL-01" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_logout"
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:layout_gravity="top"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- ============ 2x2 node scoped counters, overlapping the header ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="-28dp"
                android:layout_marginEnd="@dimen/screen_padding"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Bookings waiting for this node\'s staff to approve them. -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SmartSolar.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_circle_light"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/solar_700" />

                            <TextView
                                android:id="@+id/text_stat_pending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:text="0"
                                android:textColor="@color/slate_900"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_pending" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SmartSolar.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_circle_light"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/solar_700" />

                            <TextView
                                android:id="@+id/text_stat_approved"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:text="0"
                                android:textColor="@color/slate_900"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_approved_upcoming" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <!-- Transfers finalised at this node, with today\'s share underneath. -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SmartSolar.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_circle_light"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_history"
                                app:tint="@color/solar_700" />

                            <TextView
                                android:id="@+id/text_stat_completed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:text="0"
                                android:textColor="@color/slate_900"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_completed" />

                            <!-- Today\'s figure, also supplied by the dashboard payload. -->
                            <TextView
                                android:id="@+id/text_stat_today"
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/grid_600"
                                tools:text="3 today" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SmartSolar.Card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_circle_light"
                                android:contentDescription="@null"
                                android:padding="7dp"
                                android:src="@drawable/ic_bolt"
                                app:tint="@color/solar_700" />

                            <TextView
                                android:id="@+id/text_stat_energy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:text="0"
                                android:textColor="@color/slate_900"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="812.5 kWh" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/stat_energy" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ============ Primary action: scan a prosumer QR code ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_scan"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_padding"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/solar_500"
                app:contentPadding="@dimen/space_md"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_scan"
                        app:tint="@color/solar_700" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_scan_qr"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/scanner_prompt"
                            android:textColor="@color/solar_50"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Secondary actions ============ -->
            <TextView
                style="@style/TextAppearance.SmartSolar.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_padding"
                android:text="@string/section_quick_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_station_bookings"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:contentPadding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_light"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/solar_700" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/action_station_bookings"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_nearby_nodes"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:contentPadding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_light"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/solar_700" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/action_nearby_nodes"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:contentPadding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_light"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/solar_700" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/action_profile"
                            android:textColor="@color/slate_700"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============ Bookings awaiting approval ============ -->
            <TextView
                style="@style/TextAppearance.SmartSolar.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_padding"
                android:text="Awaiting approval" />

            <LinearLayout
                android:id="@+id/layout_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/loading" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/screen_padding"
                android:paddingEnd="@dimen/screen_padding"
                android:visibility="gone"
                tools:itemCount="2"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/slate_400" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/empty_no_bookings" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="Nothing is waiting for your approval right now." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_error_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/error_red" />

                <TextView
                    android:id="@+id/text_error"
                    style="@style/TextAppearance.SmartSolar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/error_generic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    style="@style/Widget.SmartSolar.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/action_retry" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
