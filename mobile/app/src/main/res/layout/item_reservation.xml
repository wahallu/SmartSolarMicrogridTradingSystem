<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : item_reservation.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : One booking row in the reservation lists. The reference sits on
                the left in a monospace face so codes line up down the list and
                the status chip sits on the right, tinted at runtime by
                ReservationAdapter. The node and window follow as plain text,
                and the footer shows the energy, a QR marker when the server has
                issued one, a cosmetic countdown and a chevron hinting the row
                opens the booking detail screen.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_reservation"
    style="@style/Widget.SmartSolar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_md"
    android:layout_marginEnd="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Reference and status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_reservation_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/slate_900"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_status"
                style="@style/Widget.SmartSolar.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textColor="@color/status_pending_text" />

        </LinearLayout>

        <!-- Microgrid node -->
        <TextView
            android:id="@+id/text_station_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/slate_900"
            android:textSize="16sp" />

        <!-- Slot day and window -->
        <TextView
            android:id="@+id/text_date_time"
            style="@style/TextAppearance.SmartSolar.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/slate_600" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/divider" />

        <!-- Energy, QR marker, countdown and the "opens detail" chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/slate_900"
                android:textSize="14sp" />

            <!-- Shown only when the server has issued a QR token for this booking. -->
            <ImageView
                android:id="@+id/image_qr_badge"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/cd_qr_code"
                android:src="@drawable/ic_qr"
                android:visibility="gone"
                app:tint="@color/grid_700" />

            <TextView
                android:id="@+id/text_hours_until"
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_xs"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/slate_500" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
