<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : item_station.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : One microgrid node card. The node code and a status pill head
                the card, the name and address follow, and a stat line closes it
                with the rated capacity, the free battery bays and the distance
                the SERVER measured for this user. StationAdapter dims the whole
                card when the node is out of service.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_station"
    style="@style/Widget.SmartSolar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_md"
    android:layout_marginEnd="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Node code and status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_station_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/slate_900"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_status"
                style="@style/Widget.SmartSolar.StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:textColor="@color/status_completed_text" />

        </LinearLayout>

        <!-- Node name -->
        <TextView
            android:id="@+id/text_station_name"
            style="@style/TextAppearance.SmartSolar.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Street address and city -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_map_pin"
                app:tint="@color/slate_400" />

            <TextView
                android:id="@+id/text_address"
                style="@style/TextAppearance.SmartSolar.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@color/divider" />

        <!-- Capacity, battery bays and the server measured distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_bolt"
                app:tint="@color/solar_500" />

            <TextView
                android:id="@+id/text_capacity"
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:maxLines="1" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginStart="@dimen/space_md"
                android:contentDescription="@null"
                android:src="@drawable/ic_battery"
                app:tint="@color/grid_600" />

            <TextView
                android:id="@+id/text_slots"
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Supplied by GET /stations/nearby; hidden when the API sent no distance. -->
            <TextView
                android:id="@+id/text_distance"
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:maxLines="1"
                android:textColor="@color/solar_700"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
