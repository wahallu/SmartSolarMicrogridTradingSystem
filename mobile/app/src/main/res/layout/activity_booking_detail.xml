<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_booking_detail.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : Full record of one energy trading reservation: its reference and
                colour coded status, the microgrid node, the booked slot, the
                traded energy, the server rendered QR code, the action buttons
                and the audit trail written by staff.

                Every action button below is a plain widget. Whether it is
                enabled is decided by BookingDetailActivity from the canModify /
                canCancel booleans the Web API sent, so the 12 hour notice rule
                (R2 / R3) is never re-implemented in this layout or in the phone.

                The frame under the toolbar holds the three mutually exclusive
                screen states: loading, content and error.

                NOTE ON LITERAL TEXT: strings.xml is owned by another module of
                this project and is not edited from here, so the handful of
                field captions that have no entry yet are written inline and the
                HardcodedText check is suppressed on the root for that reason.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <!-- The amber application bar, wired up by BaseActivity.setupToolbar. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_booking_detail"
        style="@style/Widget.SmartSolar.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height" />

    <!-- The three screen states occupy the rest of the window, one at a time. -->
    <FrameLayout
        android:id="@+id/frame_detail_states"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= STATE 1: content ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="@dimen/space_xl">

                <!-- ---------- Reference, status pill and countdown ---------- -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_header"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- The reference is monospaced so its digit groups line up. -->
                        <TextView
                            android:id="@+id/text_detail_reservation_no"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:textColor="@color/slate_900"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="RSV-20260904-0001" />

                        <!-- Status name and pill colour both come from the API's status value. -->
                        <TextView
                            android:id="@+id/text_detail_status"
                            style="@style/Widget.SmartSolar.StatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            tools:text="Approved" />

                        <!-- Cosmetic countdown built from the server's hoursUntilStart figure. -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/img_detail_hours"
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/slate_400" />

                            <TextView
                                android:id="@+id/text_detail_hours"
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                tools:text="in 3 days" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ---------- Node, slot, window and energy ---------- -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_fields"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Microgrid node: name on top, code beneath it. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_select_station" />

                        <TextView
                            android:id="@+id/text_detail_station_name"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Malabe Solar Hub" />

                        <TextView
                            android:id="@+id/text_detail_station_code"
                            style="@style/TextAppearance.SmartSolar.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="STN-001" />

                        <!-- Booked slot. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/label_select_slot" />

                        <TextView
                            android:id="@+id/text_detail_slot_code"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="S3" />

                        <!-- Slot day, formatted from reservationStartUtc. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/label_select_date" />

                        <TextView
                            android:id="@+id/text_detail_date"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="04 Sep 2026" />

                        <!-- Slot window, sent by the server already formatted. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="Time window" />

                        <TextView
                            android:id="@+id/text_detail_time"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="08:00 - 10:00" />

                        <!-- Direction of the transfer: charging or drop-off. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="Transfer type" />

                        <TextView
                            android:id="@+id/text_detail_type"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="Battery charging" />

                        <!-- Energy requested when the booking was placed. -->
                        <TextView
                            style="@style/TextAppearance.SmartSolar.FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:text="@string/label_energy_kwh" />

                        <TextView
                            android:id="@+id/text_detail_energy"
                            style="@style/TextAppearance.SmartSolar.FieldValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="18.0 kWh" />

                        <!-- Delivered energy: present only once an operator finalised the transfer. -->
                        <LinearLayout
                            android:id="@+id/row_detail_delivered"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                style="@style/TextAppearance.SmartSolar.FieldLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_delivered_kwh" />

                            <TextView
                                android:id="@+id/text_detail_delivered"
                                style="@style/TextAppearance.SmartSolar.FieldValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/grid_700"
                                tools:text="17.4 kWh" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                  ---------- QR code ----------
                  Shown only for an approved booking that still holds a server issued
                  token. The PNG itself is rendered by the WEB API and arrives base64
                  encoded, so the phone carries no QR generation library at all.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_qr"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Booking QR code" />

                        <!-- Spinner shown while GET /reservations/{id}/qr is in flight. -->
                        <ProgressBar
                            android:id="@+id/progress_detail_qr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:indeterminate="true" />

                        <ImageView
                            android:id="@+id/image_detail_qr"
                            android:layout_width="240dp"
                            android:layout_height="240dp"
                            android:layout_marginTop="@dimen/space_md"
                            android:adjustViewBounds="true"
                            android:background="@color/white"
                            android:contentDescription="@string/cd_qr_code"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            tools:src="@drawable/ic_qr"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_detail_qr_hint"
                            style="@style/TextAppearance.SmartSolar.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:gravity="center"
                            android:text="@string/qr_instruction" />

                        <!-- Shown instead of the image when the QR call itself failed. -->
                        <TextView
                            android:id="@+id/text_detail_qr_error"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:background="@drawable/bg_error_panel"
                            android:gravity="center"
                            android:padding="@dimen/space_md"
                            android:textColor="@color/error_red"
                            android:visibility="gone"
                            tools:text="@string/error_generic"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                  ---------- 12 hour notice panel ----------
                  Displayed when the booking is still open (Pending or Approved) but the
                  API answered canModify = false, so the user is told WHY the buttons
                  below are inactive rather than being left guessing.
                -->
                <LinearLayout
                    android:id="@+id/panel_detail_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_warning_panel"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/img_detail_notice"
                        android:layout_width="@dimen/icon_sm"
                        android:layout_height="@dimen/icon_sm"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/warning_amber" />

                    <TextView
                        android:id="@+id/text_detail_notice"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:text="@string/notice_12_hour"
                        android:textColor="@color/solar_800" />
                </LinearLayout>

                <!--
                  ---------- Prosumer actions ----------
                  Enabled state is set in Java from reservation.canModify() and
                  reservation.canCancel(), which are the SERVER's verdicts.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_edit"
                    style="@style/Widget.SmartSolar.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/action_edit_booking"
                    android:visibility="gone"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/white"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_cancel"
                    style="@style/Widget.SmartSolar.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/action_cancel_booking"
                    android:visibility="gone"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/white"
                    tools:visibility="visible" />

                <!--
                  ---------- Grid operator actions ----------
                  Only shown to a signed in Grid Operator looking at a Pending booking.
                  Hiding them for a prosumer is a courtesy: the API enforces the role
                  rule (R10) and refuses these two calls for a prosumer regardless.
                -->
                <LinearLayout
                    android:id="@+id/row_detail_staff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detail_approve"
                        style="@style/Widget.SmartSolar.Button.Success"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="Approve"
                        app:icon="@drawable/ic_check_circle"
                        app:iconTint="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_detail_reject"
                        style="@style/Widget.SmartSolar.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reject"
                        app:icon="@drawable/ic_close"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <!--
                  ---------- Audit trail ----------
                  Whatever the server recorded about this booking: who approved it, who
                  finalised the transfer, the operator's notes and any cancellation or
                  rejection reason. Each row hides itself when the field is absent.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_detail_audit"
                    style="@style/Widget.SmartSolar.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audit trail" />

                        <TextView
                            android:id="@+id/text_detail_approved"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:visibility="gone"
                            tools:text="Approved by operator1 on 03 Sep 2026, 09:12"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_detail_completed"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:visibility="gone"
                            tools:text="Completed by operator1 on 04 Sep 2026, 10:05"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_detail_notes"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:visibility="gone"
                            tools:text="Operator notes: battery healthy"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_detail_cancel_reason"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:textColor="@color/status_cancelled_text"
                            android:visibility="gone"
                            tools:text="Cancellation reason: travelling"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/text_detail_rejected_reason"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:textColor="@color/status_rejected_text"
                            android:visibility="gone"
                            tools:text="Rejection reason: node under maintenance"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= STATE 2: loading ================= -->
        <ProgressBar
            android:id="@+id/progress_detail"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            tools:visibility="gone" />

        <!-- ================= STATE 3: error ================= -->
        <ScrollView
            android:id="@+id/state_detail_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <ImageView
                    android:id="@+id/img_detail_error"
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/error_red" />

                <!-- The wording shown here is the message the API itself supplied. -->
                <TextView
                    android:id="@+id/text_detail_error"
                    style="@style/TextAppearance.SmartSolar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/error_generic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detail_retry"
                    style="@style/Widget.SmartSolar.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/action_retry" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</LinearLayout>
