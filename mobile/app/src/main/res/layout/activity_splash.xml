<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_splash.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : The launch screen. It shows the brand mark on the amber solar
                gradient while SplashActivity reads the stored session out of the
                local SQLite database and decides whether to open a role home
                screen or the login form.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_solar">

    <!-- Brand mark, vertically centred slightly above the middle of the screen. -->
    <ImageView
        android:id="@+id/img_splash_logo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/cd_app_logo"
        android:src="@drawable/ic_sun"
        app:layout_constraintBottom_toTopOf="@+id/txt_splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/white" />

    <!-- Application name. -->
    <TextView
        android:id="@+id/txt_splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/app_full_name"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/txt_splash_tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_splash_logo" />

    <!-- One line explaining what the product does. -->
    <TextView
        android:id="@+id/txt_splash_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_xl"
        android:gravity="center"
        android:text="@string/app_tagline"
        android:textColor="@color/solar_100"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_splash_title" />

    <!-- Indeterminate spinner: the wait is a fixed short delay plus a SQLite read. -->
    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xl"
        android:indeterminate="true"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
