<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_splash.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : The launch screen. It shows the brand mark on the flat amber
                accent while SplashActivity reads the stored session out of the
                local SQLite database and decides whether to open a role home
                screen or the login form.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/accent">

    <!-- Brand mark: an ink tile carrying the amber sun, centred as one group. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_splash_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_brand_tile"
            android:contentDescription="@string/cd_app_logo"
            android:padding="18dp"
            android:src="@drawable/ic_sun"
            app:tint="@color/accent" />

        <!-- Application name. -->
        <TextView
            android:id="@+id/txt_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_full_name"
            android:textColor="@color/accent_ink"
            android:textSize="24sp" />

        <!-- One line explaining what the product does. -->
        <TextView
            android:id="@+id/txt_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_xl"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="@color/accent_ink"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- Indeterminate spinner: the wait is a fixed short delay plus a SQLite read. -->
    <ProgressBar
        android:id="@+id/progress_splash"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="@dimen/space_xl"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_ink"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
