<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_prosumer_home.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : Home screen of a Solar Prosumer. Shows the live dashboard
                counters returned by GET /reservations/dashboard, the booking
                actions and the prosumer's next bookings.

                Every figure on this screen is a value the Web API sent. The
                layout only supplies the placeholders - nothing is counted on
                the phone, which keeps the business logic in the FAT service.

                A SwipeRefreshLayout wraps the whole page so a pull down
                re-reads the dashboard.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl">

            <!-- ============ Who is signed in ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs">

                <!-- Avatar circle carrying the first letter of the account holder's name. -->
                <TextView
                    android:id="@+id/text_avatar_initial"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_solar"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="N" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/slate_600"
                        android:textSize="13sp"
                        tools:text="@string/greeting_morning" />

                    <TextView
                        android:id="@+id/text_user_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/slate_900"
                        android:textSize="20sp"
                        tools:text="Nimal Perera" />

                    <TextView
                        android:id="@+id/text_user_nic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/slate_600"
                        android:textSize="12sp"
                        tools:text="200145678912" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_logout"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_logout"
                    android:padding="12dp"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/slate_700" />
            </LinearLayout>

            <!-- ============ Live figures: one framed summary, not four tiles ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_padding"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Energy traded: dashboard.totalEnergyKwh, formatted by the model. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_energy" />

                        <TextView
                            android:id="@+id/text_stat_energy"
                            style="@style/TextAppearance.SmartSolar.Figure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="0"
                            android:textSize="32sp"
                            tools:text="812.5 kWh" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Pending: dashboard.pendingReservations, straight from the API. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <TextView
                                android:id="@+id/text_stat_pending"
                                style="@style/TextAppearance.SmartSolar.Figure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/stat_pending" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <!-- Approved and still in the future: dashboard.approvedFutureReservations. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <TextView
                                android:id="@+id/text_stat_approved"
                                style="@style/TextAppearance.SmartSolar.Figure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/stat_approved_upcoming" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <!-- Completed transfers: dashboard.completedReservations. -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <TextView
                                android:id="@+id/text_stat_completed"
                                style="@style/TextAppearance.SmartSolar.Figure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0" />

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/stat_completed" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Actions: one primary, three quiet rows ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_new_booking"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_padding"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/accent"
                app:contentPadding="@dimen/space_md"
                app:rippleColor="@color/accent_pressed"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_add"
                        app:tint="@color/accent_ink" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/action_new_booking"
                        android:textColor="@color/accent_ink"
                        android:textSize="16sp" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/accent_ink" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_my_bookings"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:clickable="true"
                android:focusable="true"
                app:contentPadding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/slate_700" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/action_my_bookings"
                        android:textColor="@color/slate_900"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/slate_500" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_nearby_nodes"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:clickable="true"
                android:focusable="true"
                app:contentPadding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/slate_700" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/action_nearby_nodes"
                        android:textColor="@color/slate_900"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/slate_500" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:clickable="true"
                android:focusable="true"
                app:contentPadding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="32dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person"
                        app:tint="@color/slate_700" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:text="@string/action_profile"
                        android:textColor="@color/slate_900"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/slate_500" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Upcoming bookings ============ -->
            <TextView
                style="@style/TextAppearance.SmartSolar.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginEnd="@dimen/screen_padding"
                android:text="@string/section_upcoming" />

            <!-- Loading state. -->
            <LinearLayout
                android:id="@+id/layout_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/slate_900" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/loading" />
            </LinearLayout>

            <!-- Content state: the bookings the API returned in dashboard.upcoming. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:itemCount="2"
                tools:visibility="visible" />

            <!-- Empty state. -->
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/slate_500" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/empty_no_bookings" />

                <TextView
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/empty_no_bookings_message" />
            </LinearLayout>

            <!-- Error state, shown when the dashboard call fails. -->
            <LinearLayout
                android:id="@+id/layout_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_padding"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_padding"
                android:background="@drawable/bg_error_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/error_red" />

                <TextView
                    android:id="@+id/text_error"
                    style="@style/TextAppearance.SmartSolar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/error_generic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry"
                    style="@style/Widget.SmartSolar.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/action_retry" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
