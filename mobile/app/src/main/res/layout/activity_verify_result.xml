<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_verify_result.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : The second half of the "read QR code and update the job as done"
                requirement. It shows the booking the Web API returned for a
                verified QR token, and carries the short form that finalises the
                energy transfer.

                EVERY VALUE IN THE CARD BELOW IS THE SERVER'S. The scanner did
                not decide that this booking is valid, approved or inside its
                window - POST reservations/verify-qr did (rule R9), and the
                payload it returned is what these fields display. The two inputs
                at the foot of the screen are the only values this phone
                contributes, and even they are validated again by the API when
                POST reservations/complete is called.

                NOTE ON LITERAL TEXT: strings.xml is owned by another module of
                this project and is not edited from here, so the field captions
                that have no entry yet are written inline and the HardcodedText
                check is suppressed on the root for that reason.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <!-- The amber application bar, wired up by BaseActivity.setupToolbar. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_verify_result"
        style="@style/Widget.SmartSolar.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_verify"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_xl">

            <!--
              ========== Verified banner ==========
              The green panel states the SERVER's verdict. It is shown
              unconditionally because this screen is only ever reached after the
              API answered success to the verification call.
            -->
            <LinearLayout
                android:id="@+id/panel_verify_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_success_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:id="@+id/img_verify_banner"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:contentDescription="@string/verify_title"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/grid_600" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_verify_banner_title"
                        style="@style/TextAppearance.SmartSolar.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Booking verified"
                        android:textColor="@color/grid_800" />

                    <TextView
                        android:id="@+id/text_verify_banner_message"
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The server accepted this QR code. Confirm the details before finalising."
                        android:textColor="@color/grid_700" />
                </LinearLayout>
            </LinearLayout>

            <!--
              ========== The booking, exactly as the API returned it ==========
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verify_details"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Reference, monospaced so its digit groups line up. -->
                    <TextView
                        android:id="@+id/text_verify_reservation_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/slate_900"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="RSV-20260904-0001" />

                    <!-- Status name and pill colour both come from the API's status value. -->
                    <TextView
                        android:id="@+id/text_verify_status"
                        style="@style/Widget.SmartSolar.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        tools:text="Approved" />

                    <!-- ==== Prosumer ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Prosumer" />

                    <TextView
                        android:id="@+id/text_verify_prosumer_name"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Nimal Perera" />

                    <TextView
                        android:id="@+id/text_verify_prosumer_nic"
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        tools:text="199512345678" />

                    <!-- ==== Microgrid node ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/label_select_station" />

                    <TextView
                        android:id="@+id/text_verify_station_name"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Malabe Solar Hub" />

                    <TextView
                        android:id="@+id/text_verify_station_code"
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="STN-001" />

                    <!-- ==== Slot ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/label_select_slot" />

                    <TextView
                        android:id="@+id/text_verify_slot_code"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="S3" />

                    <!-- ==== Slot day ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/label_select_date" />

                    <TextView
                        android:id="@+id/text_verify_date"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="04 Sep 2026" />

                    <!-- ==== Slot window, sent by the server already formatted ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Time window" />

                    <TextView
                        android:id="@+id/text_verify_time"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="08:00 - 10:00" />

                    <!-- ==== Direction of the transfer ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="Transfer type" />

                    <TextView
                        android:id="@+id/text_verify_type"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Battery charging" />

                    <!-- ==== Energy requested when the booking was placed ==== -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/label_energy_kwh" />

                    <TextView
                        android:id="@+id/text_verify_energy"
                        style="@style/TextAppearance.SmartSolar.FieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="18.0 kWh" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!--
              ========== Finalise the transfer ==========
              The operator records what was actually delivered and any notes. The
              app checks only that the figure is a non negative number so a bad
              keystroke is caught without a round trip; the API re-validates it.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_verify_form"
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.SmartSolar.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_finalise_transfer" />

                    <!-- Prefilled with the requested energy, which is the usual figure. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_verify_delivered"
                        style="@style/Widget.SmartSolar.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/label_delivered_kwh"
                        app:startIconDrawable="@drawable/ic_bolt"
                        app:startIconTint="@color/solar_600">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_verify_delivered"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Free text the API stores against the booking as operatorNotes. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_verify_notes"
                        style="@style/Widget.SmartSolar.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/label_operator_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_verify_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="4"
                            android:minLines="2" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shown while POST reservations/complete is in flight. -->
            <ProgressBar
                android:id="@+id/progress_verify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_finalise"
                style="@style/Widget.SmartSolar.Button.Success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/action_finalise_transfer"
                app:icon="@drawable/ic_check_circle"
                app:iconTint="@color/white" />

            <!--
              A reminder that the code is single use. The SERVER clears the QR
              token when the transfer is completed, so a second scan of the same
              printed code is refused by the API as QR_INVALID.
            -->
            <LinearLayout
                android:id="@+id/panel_verify_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_info_panel"
                android:orientation="horizontal"
                android:padding="@dimen/space_md">

                <ImageView
                    android:id="@+id/img_verify_notice"
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/info_blue" />

                <TextView
                    android:id="@+id/text_verify_notice"
                    style="@style/TextAppearance.SmartSolar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="Finalising closes this booking. The server retires the QR code, so it cannot be scanned a second time." />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
