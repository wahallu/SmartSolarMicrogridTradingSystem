<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  File        : activity_login.xml
  Project     : Smart Solar Microgrid Trading System - Android Client
  Description : Sign in form. A photograph of a solar array sits above the form,
                which collects the identifier (NIC, username or e-mail) and the
                password, then hands them to POST /auth/login. The whole screen
                scrolls so the fields stay reachable when the soft keyboard is up.
  Author      : Smart Solar Microgrid Team - SE4040 Enterprise Application Dev
  Created     : 2026-09-04
  =============================================================================
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- A real photograph, left clean: no text or badges laid over it. -->
        <ImageView
            android:id="@+id/img_login_hero"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="@string/cd_login_photo"
            android:scaleType="centerCrop"
            android:src="@drawable/img_login_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="24dp"
            android:paddingBottom="@dimen/space_lg">

            <!-- Brand row. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_login_logo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_brand_tile_accent"
                    android:contentDescription="@string/cd_app_logo"
                    android:padding="7dp"
                    android:src="@drawable/ic_sun"
                    app:tint="@color/accent_ink" />

                <TextView
                    android:id="@+id/txt_login_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_full_name"
                    android:textColor="@color/slate_900"
                    android:textSize="16sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_login_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.SmartSolar.PageTitle" />

            <TextView
                android:id="@+id/txt_login_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.SmartSolar.Body"
                android:textColor="@color/slate_600" />

            <!-- Identifier accepts a NIC, a username or an e-mail address. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_identifier"
                style="@style/Widget.SmartSolar.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:hint="@string/hint_identifier"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_identifier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.SmartSolar.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/hint_password"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                style="@style/Widget.SmartSolar.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/action_login" />

            <!-- Shown only while the login request is in flight. -->
            <ProgressBar
                android:id="@+id/progress_login"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:indeterminate="true"
                android:indeterminateTint="@color/slate_900"
                android:visibility="gone" />

            <!-- Route to self registration. -->
            <LinearLayout
                android:id="@+id/row_login_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_no_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_account_prompt"
                    android:textAppearance="@style/TextAppearance.SmartSolar.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_go_register"
                    style="@style/Widget.SmartSolar.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_register" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
