# Normalise line endings so the repository stays consistent across machines.
* text=auto eol=lf

# Windows-native files keep CRLF.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.sln        text eol=crlf

# Gradle wrapper script must stay LF to run on a POSIX shell.
gradlew      text eol=lf

# Binary assets - never convert.
*.png        binary
*.jpg        binary
*.jar        binary
*.apk        binary
*.pdf        binary
*.keystore   binary
